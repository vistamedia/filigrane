# Coordonnées du serveur de production.
#
#   cp .deploiement.env.example .deploiement.env
#   puis renseigner les valeurs ci-dessous.
#
# Ce fichier-ci est suivi par Git ; .deploiement.env ne l'est pas. Les scripts
# de déploiement, de sauvegarde et de contrôle le lisent automatiquement s'il
# existe, et se rabattent sinon sur les variables d'environnement.
#
# Rien de tout cela n'a sa place dans un dépôt public : un identifiant SSH et
# l'arborescence d'un serveur sont la moitié d'une porte d'entrée.

# Compte SSH de l'hébergement.
FILIGRANE_SSH_USER=votre-compte
FILIGRANE_SSH_HOST=ssh.votre-hebergeur.net
FILIGRANE_SSH_KEY=$HOME/.ssh/id_ed25519

# Où vit l'application, hors de la racine web.
FILIGRANE_APP_DIR=/home/votre-compte/apps/filigrane

# La racine web du sous-domaine, servie par Apache.
FILIGRANE_WEB_DIR=/home/votre-compte/filigrane.exemple.fr

# L'adresse publique, utilisée par les contrôles d'après déploiement.
FILIGRANE_URL=https://filigrane.exemple.fr
